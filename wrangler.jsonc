{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-institute-site",
  "account_id": "1ac6d89c2eeba85a5390422d6fe97613",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CF_WORKERS": "1"
  },
  "previews": {
    "vars": {
      "CF_WORKERS_PREVIEW": "1"
    }
  },
  "services": [
    {
      "binding": "VALU_ASSESSMENT",
      "service": "valoria-assessment"
    }
  ]
}
