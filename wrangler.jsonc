{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-institute-site",
  "account_id": "1ac6d89c2eeba85a5390422d6fe97613",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CF_WORKERS": "1"
  },
  "previews": {
    "vars": {
      "CF_WORKERS_PREVIEW": "1"
    }
  },
  "services": [
    {
      "binding": "VALU_ASSESSMENT",
      "service": "valoria-assessment"
    }
  ],
  "env": {
    "staging": {
      "name": "valoria-staging-site",
      // The staging route is already attached to this Worker in Cloudflare; keep route management out of this CI token scope.
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "services": [
        {
          "binding": "VALU_ASSESSMENT",
          "service": "valoria-staging-assessment"
        }
      ],
      "vars": {
        "CF_WORKERS": "1",
        "CF_WORKERS_PREVIEW": "1",
        "SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
        "NEXT_PUBLIC_SUPABASE_URL": "https://yccxgjdqworgcbircnvn.supabase.co",
        "NEXT_PUBLIC_SITE_URL": "https://staging.valoriainstitute.com",
        "VALU_ASSESSMENT_ORIGIN": "https://assessment-staging.valoriainstitute.com",
        "VALU_UPSTREAM_ORIGIN": "https://assessment-staging.valoriainstitute.com",
        "VALU_PREVIEW_ASSESSMENT_ORIGIN": "https://assessment-staging.valoriainstitute.com",
        "NEXT_PUBLIC_VALU_ASSESSMENT_ORIGIN": "https://assessment-staging.valoriainstitute.com",
        "VALU_PREVIEW": "1",
        "NEXT_PUBLIC_VALU_PREVIEW": "1",
        "VALU_STAGING_API_ENABLED": "1",
        "NEXT_PUBLIC_VALU_STAGING_API_ENABLED": "1"
      }
    }
  }
}
