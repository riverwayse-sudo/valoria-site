{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valoria-institute-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CF_WORKERS": "1"
  },
  "previews": {
    "vars": {
      "CF_WORKERS_PREVIEW": "1",
      "VALU_PREVIEW": "1",
      "NEXT_PUBLIC_VALU_PREVIEW": "1",
      "VALU_PREVIEW_SITE_ORIGIN": "https://valoria-staging-site.riverwayse.workers.dev",
      "VALU_PREVIEW_ASSESSMENT_ORIGIN": "https://valoria-staging-assessment.riverwayse.workers.dev",
      "NEXT_PUBLIC_VALU_ASSESSMENT_ORIGIN": "https://valoria-staging-assessment.riverwayse.workers.dev",
      "NEXT_PUBLIC_SUPABASE_URL": "https://preview-disabled.invalid",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY": "preview-disabled-anon-key"
    }
  },
  "env": {
    "staging": {
      "name": "valoria-staging-site",
      "vars": {
        "VALU_PREVIEW": "1",
        "NEXT_PUBLIC_VALU_PREVIEW": "1",
        "VALU_PREVIEW_SITE_ORIGIN": "https://valoria-staging-site.riverwayse.workers.dev",
        "VALU_PREVIEW_ASSESSMENT_ORIGIN": "https://valoria-staging-assessment.riverwayse.workers.dev",
        "VALU_UPSTREAM_ORIGIN": "https://valoria-staging-assessment.riverwayse.workers.dev",
        "NEXT_PUBLIC_SUPABASE_URL": "https://preview-disabled.invalid",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "preview-disabled-anon-key"
      }
    }
  }
}
