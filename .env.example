NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Environment-specific public origin of THIS deployment.
# Staging: the staging origin. Production: https://valoriainstitute.com.
# Must also be present in the Supabase Auth redirect allowlist.
# When unset, the app falls back to the current browser origin, then to the
# production origin (see src/lib/site-url.js).
NEXT_PUBLIC_SITE_URL=

# Upstream origin of the full VALU assessment application. Used by the
# /valu/assessment/* rewrite in next.config.js and by /api/trigger-report.
VALU_UPSTREAM_ORIGIN=

# Absolute public URL of the full VALU assessment app, used by /api/valu-handoff.
# Defaults to https://valoriainstitute.com/valu/assessment/ when unset.
VALU_ASSESSMENT_URL=

# Brevo transactional email (welcome, careers, enquiries, reminders).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Secret guarding the scheduled cron routes.
CRON_SECRET=

# Server-side fallback used only when NEXT_PUBLIC_SUPABASE_URL is unset. The
# reconciliation-health cron route reads it; normal code paths do not.
SUPABASE_URL=

# Analytics. Both are public and optional: when unset, the corresponding tag is
# not injected at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Brevo list targeting for event registrations. Optional; without a list id the
# contact is created but not added to a list.
BREVO_LIST_ID=
BREVO_WEBINAR_LIST_ID=
# "true" to send the custom attribute payload with each Brevo contact.
BREVO_CUSTOM_ATTRIBUTES_ENABLED=

# Provided automatically by Vercel ("production" | "preview" | "development").
# Read by /api/health to report the environment. Do not set by hand.
VERCEL_ENV=

# Test-only. Point these at the two repository checkouts so the cross-repository
# scoring-parity test can read both engines. In CI they are set by the workflow;
# locally they default to sibling directories.
VALORIA_PLATFORM_ROOT=
VALORIA_SITE_ROOT=

# --- Environment write guard (src/lib/environment-guard.js) ---
# The guard decides whether this deployment may perform a privileged Supabase
# write. It requires the runtime AND the target database to be positively
# identified, so nothing is allowed by default.
#
# On Vercel, VERCEL_ENV is provided automatically. Set exactly one of the two
# project refs below per scope (the 20-character ref from the Supabase project
# URL, e.g. abcdefghijklmnopqrst in https://abcdefghijklmnopqrst.supabase.co):
#   Production scope -> PRODUCTION_SUPABASE_PROJECT_REF
#   Preview scope    -> STAGING_SUPABASE_PROJECT_REF
#
# Until the matching ref is set, a privileged write from that scope is refused
# with HTTP 503 rather than silently reaching the wrong database. That is the
# intended fail-closed behaviour.
PRODUCTION_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_PROJECT_REF=

# Local development and the test runner only. Vercel never sets this. When the
# runtime is unidentified (VERCEL_ENV unset) a privileged write is refused unless
# this is exactly "true", and even then the target must still match the declared
# staging project. Do not set this on a deployed environment.
ALLOW_LOCAL_PRIVILEGED_WRITES=
