NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Server-only assessment origin for dashboard-issued handoffs.
# Production defaults to the canonical assessment host; previews require their paired preview origin.
VALU_UPSTREAM_ORIGIN=
# Used to reject accidental production-project credentials in Preview.
VALU_PRODUCTION_SUPABASE_URL=

# Optional isolated Preview Supabase project. Leave unset to fail closed.
VALU_PREVIEW_SUPABASE_URL=
VALU_PREVIEW_SUPABASE_ANON_KEY=
VALU_PREVIEW_SUPABASE_SERVICE_ROLE_KEY=
